{
  "name": "mirabelu",
  "version": "0.1.0",
  "private": true,
  "description": "Mirabelu — plateforme de livres audio par abonnement",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @mirabelu/database generate",
    "db:migrate": "pnpm --filter @mirabelu/database migrate:deploy",
    "db:seed": "pnpm --filter @mirabelu/database seed"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "~5.9.3"
  }
}
