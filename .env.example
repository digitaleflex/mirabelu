# Mirabelu — configuration. Copier vers .env (jamais committé).
# Les secrets ci-dessous sont des exemples : générer les vôtres (openssl rand -hex 32).

NODE_ENV=development
LOG_LEVEL=info

# --- Base de données (PostgreSQL 16+) -------------------------------------
DATABASE_URL=postgresql://mirabelu:mirabelu@localhost:5432/mirabelu

# --- AURA Storage (stockage des fichiers audio) ---------------------------
AURA_API_URL=https://aura.example.com
# Identité machine dédiée à Mirabelu : aura_<id>_<secret>
AURA_API_TOKEN=
# Vide = bucket par défaut de l'espace
AURA_BUCKET=
AURA_INTENT_TTL_SECONDS=900
PLAYBACK_URL_CACHE_SECONDS=780

# --- API -------------------------------------------------------------------
PORT=4000
HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000
JWT_SECRET=change-me-change-me-change-me-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# true obligatoire en production (HTTPS)
COOKIE_SECURE=false
# Derrière le proxy /api du site web : /api/auth
REFRESH_COOKIE_PATH=/api/auth
# Numéros administrateurs (E.164, séparés par des virgules)
ADMIN_PHONES=
# Sauts de proxy de confiance devant l'API (le site web qui proxifie /api = 1). 0 = aucun.
TRUST_PROXY_HOPS=1
DEFAULT_PHONE_COUNTRY=BJ

# --- Codes de connexion (OTP) ----------------------------------------------
# console = affiche le code dans les logs (développement uniquement)
# webhook = POST JSON vers OTP_WEBHOOK_URL (passerelle SMS/WhatsApp), obligatoire en production
OTP_DELIVERY=console
OTP_WEBHOOK_URL=
OTP_WEBHOOK_TOKEN=
# Coupe-circuit anti-fraude SMS : codes envoyés par heure, tous numéros / par préfixe pays
OTP_MAX_PER_HOUR_GLOBAL=300
OTP_MAX_PER_HOUR_PER_PREFIX=200
# GET /metrics (Prometheus) : jeton d'au moins 16 caractères ; vide = désactivé
METRICS_TOKEN=

# --- Paiements --------------------------------------------------------------
# Liste parmi : fedapay, kkiapay, mock (mock interdit en production)
PAYMENT_PROVIDERS=mock

FEDAPAY_SECRET_KEY=
FEDAPAY_ENV=sandbox
FEDAPAY_WEBHOOK_SECRET=

KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET=
KKIAPAY_SANDBOX=true
KKIAPAY_WEBHOOK_SECRET=
KKIAPAY_WEBHOOK_HEADER=x-kkiapay-secret

# --- Worker audio -----------------------------------------------------------
IMPORT_DIR=/data/imports
WORK_DIR=/tmp/mirabelu-worker
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
STREAM_BITRATE_KBPS=64
WORKER_CONCURRENCY=1
MAX_SOURCE_BYTES=5368709120

# --- Site web (Next.js) -----------------------------------------------------
# Adresse interne de l'API, utilisée par le proxy /api du site
API_URL=http://localhost:4000

# --- Tests ------------------------------------------------------------------
TEST_DATABASE_ADMIN_URL=postgresql://mirabelu:mirabelu@127.0.0.1:54329/postgres
