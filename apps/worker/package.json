{
  "name": "@mirabelu/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/main.ts",
  "exports": {
    "./pipeline": "./src/pipeline.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "generate": "echo ok"
  },
  "dependencies": {
    "@mirabelu/audio": "workspace:*",
    "@mirabelu/config": "workspace:*",
    "@mirabelu/contracts": "workspace:*",
    "@mirabelu/database": "workspace:*",
    "@mirabelu/storage": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "^8.16.3",
    "pg-boss": "^11.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
